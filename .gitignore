fish_variables*

# Fisher-managed plugin output. Only the fish_plugins manifest is tracked;
# conf.d/fisher-bootstrap.fish reinstalls these from it on a fresh machine.
#
# mise dotfiles symlinks each file individually rather than the whole
# directory (the equivalent of stow's --no-folding), so these land as plain
# files in the real ~/.config/fish/ and never reach the repo. These rules are
# the safety net in case a target ever gets added as a whole-directory entry.
.config/fish/functions/_tide_*.fish
.config/fish/functions/tide/
.config/fish/functions/tide.fish
.config/fish/functions/fisher.fish
.config/fish/functions/fish_prompt.fish
.config/fish/functions/fish_right_prompt.fish
.config/fish/completions/tide.fish
.config/fish/completions/fisher.fish
.config/fish/conf.d/_tide_init.fish

# Local worktrees
.worktrees/

# Credentials. gh writes OAuth tokens into hosts.yml in the same directory
# as the tracked config.yml. Never commit it.
.config/gh/hosts.yml

# superfile ships its own theme/ directory; nothing in it is hand-edited.
.config/superfile/theme/

# ~/.pi is tracked here (absorbed from pi-mono 2026-08-30). The global
# **/.pi/ ignore rule is for project-local pi state; this repo's copy is
# the real thing, so re-include it.
!.pi/
!.pi/**

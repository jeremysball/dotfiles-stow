// ~/.config/opencode/opencode.jsonc
//
// OpenCode global config — loaded once on startup, NOT hot-reloaded. Quit
// and restart opencode after any edit.
//
// Sources of truth:
//   - Schema:    https://opencode.ai/config.json
//   - Model DB:  https://github.com/anomalyco/models.dev/tree/dev/providers/<provider>
//   - Provider docs: linked per-provider below
//
// Conventions for this file:
//   - `cheapestinference` is a CUSTOM provider, not in models.dev — its model
//     definitions here are hand-written against the cheapinference API. See
//     `~/.config/opencode/skills/configure-opencode-provider` for the
//     process to add a new model.
//
// Variant naming on the default model:
//   opencode-go/minimax-m3 exposes variants `none` (thinking off) and
//   `thinking` (adaptive thinking on). It does NOT expose `high`/`max`.
//   glm-5.2 also declares `high`/`max` variants — as of 2026-07-20 these
//   are no-op identifiers (reasoning is force-disabled on the model to
//   sidestep a parser bug), kept so `/model glm-5.2:max` still resolves.

{
  "$schema": "https://opencode.ai/config.json",

  // Compaction: cap the effective context window at 200k tokens across all
  // actively-dispatched models, then reserve 25k of that as the trigger
  // buffer so auto-compact fires once used context crosses ~175k
  // (per the schema, `reserved` is a literal token buffer subtracted from
  // limit.context, NOT a percentage — verified against
  // https://opencode.ai/config.json's Config.compaction.reserved
  // description: "Token buffer for compaction. Leaves enough window to
  // avoid overflow during compaction." 2026-08-03: the prior comment here
  // claiming a percentage-based trigger was wrong, and several
  // actively-dispatched built-in providers (minimax, opencode-go, openai,
  // openrouter) had no limit.context override at all, so they were running
  // at their real 200k-1.05M raw limits, nowhere near triggering compaction
  // early. Added explicit 200000-context overrides for every actively
  // dispatched model below to close that gap — add new models here
  // whenever the fleet changes (see using-taskferry's "Always Use A
  // Worktree" and the choosing-a-model skill for what's actively dispatched).
  //   docs: https://opencode.ai/config.json ($defs.Config.properties.compaction)
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 20000,
    "reserved": 25000
  },

  // Default model: opencode-go subscription ($10/mo, 12+ models, OpenAI-compatible).
  //   docs: https://www.bitdoze.com/opencode-go-plan/
  //   auth: `opencode providers login` then select OpenCode Go.
  //   base: https://opencode.ai/zen/go/v1
  "model": "opencode-go/minimax-m3:thinking",

  "agent": {
    "build": {
      // Default agent runs minimax-m3 with adaptive thinking. Switch per-task:
      //   /model opencode-go/minimax-m3            // default thinking
      //   /model opencode-go/minimax-m3:none       // thinking off
      //   /model opencode-go/minimax-m3:thinking   // adaptive (default)
      //   /agent glm-max                           // glm-5.2 max, reasoning off
      "model": "opencode-go/minimax-m3",
      "variant": "thinking"
    },
    "plan": {
      "model": "opencode-go/minimax-m3",
      "variant": "thinking"
    },
    "glm-max": {
      // Switch into this agent with:  /agent glm-max
      // Pinned to cheapestinference/glm-5.2 with variant `max`. Reasoning is
      // forced off on the model definition (see glm-5.2 entry below) to
      // work around the @ai-sdk/openai-compatible@2.0.41 interleaved-
      // reasoning parser bug — this agent trades the collapsible thinking
      // UI for a clean answer stream. The `max` variant is preserved as a
      // stable identifier so `/model glm-5.2:max` and external scripts keep
      // resolving the same way.
      "description": "GLM 5.2 (max variant) on cheapestinference, reasoning disabled to avoid the interleaved-reasoning parser bug.",
      "mode": "primary",
      "model": "cheapestinference/glm-5.2",
      "variant": "max"
    },
    "summarizer": {
      // Switch into this agent with:  /agent summarizer
      // Model: cheapestinference/minimax-m3. Optimized for long-context
      // summarization — quote source when condensing, preserve named entities
      // and numbers exactly, output structured prose (intro / body / closing).
      "description": "Summarization agent running on cheapestinference/minimax-m3.",
      "mode": "primary",
      "model": "cheapestinference/minimax-m3"
    },
    "title": { "disable": true }
  },

  "provider": {
    "meta": {
      // Meta Muse Spark — kept around as a non-subscription fallback.
      //   key file: ~/.config/opencode/meta-api-key
      "npm": "@ai-sdk/openai",
      "name": "Meta",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{file:/home/jeremy/.config/opencode/meta-api-key}"
      },
      "models": {
        "muse-spark-1.1": {
          "name": "Muse Spark 1.1",
          "reasoning": true,
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image", "pdf", "video"],
            "output": ["text"]
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        }
      }
    },

    "cheapestinference": {
      // Custom provider — x402-paywalled API. Models per the cheapinference
      // /v1/models endpoint (frontier pool: minimax-m3, kimi-k2.7, glm-5.2, kimi-k2.6).
      // API docs: https://docs.cheapestinference.com
      // Account: pay USDC subscription at the /v1/models endpoint per-blocks.
      //
      // Switched 2026-07-22 from @ai-sdk/openai-compatible to @ai-sdk/anthropic,
      // pointed at cheapinference's Anthropic-format route. Verified live via
      // curl — same model ids, requests reach the model (rate-limited
      // response, not a routing/auth error). This drops the need for the old
      // openai-compatible reasoning-parser workaround below.
      //
      // NOTE: baseURL must include the trailing `/v1` — @ai-sdk/anthropic
      // appends only `/messages`, not `/v1/messages` (unlike its own default
      // of `https://api.anthropic.com/v1`, which already has the `/v1`
      // baked in). Omitting it 404'd every request even though the same
      // path worked fine via raw curl.
      "npm": "@ai-sdk/anthropic",
      "name": "CheapestInference",
      "options": {
        "baseURL": "https://api.cheapestinference.com/anthropic/v1",
        "apiKey": "{env:CHEAPESTINFERENCE_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          // From models.dev: zai/glm-5.2 — reasoning_effort: high|max (default: max)
          //   https://docs.z.ai/api-reference/llm/chat-completion
          //
          // `reasoning` was restored to true on 2026-07-22 on the theory that
          // the @ai-sdk/anthropic route's native `thinking` content blocks no
          // longer needed the old openai-compatible interleaved-parser
          // workaround. Re-disabled same day (still 2026-07-22): three
          // consecutive taskferry dispatches with reasoning on (two at
          // `--variant max`, one at `--variant high`) all crashed with the
          // identical AI-SDK error `"reasoning part 0 not found"` — a
          // reasoning-delta chunk referencing an id no preceding
          // reasoning-start chunk registered, i.e. malformed/out-of-order
          // SSE framing from cheapestinference's Anthropic-format endpoint
          // itself. Not fixed by removing an unrelated dangling
          // opencode-think-strip plugin symlink that was also suspected.
          // Back to `false` — but note (2026-07-22) this does NOT fix the
          // crash and is not even a display-only mitigation: confirmed with
          // a bare dispatch using NO --variant flag at all (so no
          // reasoningEffort override could be in play), and it still
          // crashed with the identical `"reasoning part 0 not found"`
          // error within ~1s, session non-null. The cheapestinference
          // Anthropic-format endpoint sends thinking content blocks
          // unconditionally on this model, unaffected by this flag.
          // `cheapestinference/glm-5.2` is unusable for ANY taskferry
          // dispatch right now, not just high-effort variants — do not
          // dispatch to it until this is fixed upstream. See
          // working-report.md for the full failure history.
          "name": "GLM 5.2",
          "reasoning": false,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 },
          "variants": {
            "high": { "reasoningEffort": "high" },
            "max":  { "reasoningEffort": "max"  }
          }
        },
        "kimi-k2.6": {
          // From models.dev: moonshotai/kimi-k2.6 — toggle only (no effort).
          "name": "Kimi K2.6",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 65536 }
        },
        "kimi-k2.7": {
          // From models.dev: moonshotai/kimi-k2.7-code — always-on reasoning,
          // no toggle or effort surfaced.
          "name": "Kimi K2.7",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 262144 }
        },
        "minimax-m3": {
          // From models.dev: minimax/MiniMax-M3 — toggle only.
          "name": "MiniMax M3",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        }
      }
    },

    "alibaba-tknplan": {
      // Alibaba Cloud Model Studio "Token Plan" subscription (SG endpoint,
      // verified live 2026-07-29 via curl → 200 OK on
      // https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1/messages).
      // Auth: {env:ALIBABA_TKN_PLAN_API_KEY} (the Anthropic-format token-plan
      // route rejects the bare RAM AccessKey pair with 401 InvalidApiKey).
      //
      // baseURL already includes the trailing /v1 because @ai-sdk/anthropic
      // appends only /messages (unlike its own default of
      // https://api.anthropic.com/v1, which has the /v1 baked in). Omitting it
      // 404s every request.
      //
      // Only the preview model carries an explicit thinking.budgetTokens; the
      // rest rely on the provider default per user instruction.
      "npm": "@ai-sdk/anthropic",
      "name": "Alibaba Cloud Model Studio (Token Plan, SG)",
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:ALIBABA_TKN_PLAN_API_KEY}"
      },
      "models": {
        "qwen3.8-max-preview": {
          "name": "Qwen3.8 Max Preview",
          "limit": { "context": 200000, "output": 131072 },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 99072
            },
            "temperature": 0.6,
            "reasoning": true
          }
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "limit": { "context": 200000, "output": 131072 },
          "options": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "limit": { "context": 200000, "output": 131072 },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      }
    },

    "xiaomi-tknplan": {
      // Xiaomi MiMo "Token Plan" coding subscription — native Anthropic-format
      // API. {env:XIAOMI_TKN_PLAN_URL} itself ends in `/anthropic` (no `/v1`);
      // `/v1` is appended here in baseURL because @ai-sdk/anthropic only adds
      // `/messages` to whatever baseURL it's given, not `/v1/messages`.
      //   base: {env:XIAOMI_TKN_PLAN_URL}/v1 = https://token-plan-sgp.xiaomimimo.com/anthropic/v1
      //   auth: {env:XIAOMI_TKN_PLAN_API_KEY}
      // Verified live 2026-07-22 via curl: both mimo-v2.5 and mimo-v2.5-pro
      // respond with real `thinking` content blocks. Context/output limits
      // per OpenRouter's listing for the same models (1.05M ctx / 131072 out
      // for both — MiMo-V2.5 is 310B-A15B MoE, MiMo-V2.5-Pro is 1.02T-A42B).
      //
      // NOTE: id deliberately NOT "xiaomi" — opencode already ships a
      // built-in `xiaomi` provider (from models.dev; that's where the
      // unrequested `mimo-v2.5-pro-ultraspeed` model came from when this was
      // first tried under the "xiaomi" id). Reusing that id let the built-in
      // definition's baseURL win the merge over ours and every call 404'd,
      // even though the same request worked fine via raw curl. A distinct id
      // avoids the collision entirely.
      "npm": "@ai-sdk/anthropic",
      "name": "Xiaomi MiMo (Token Plan)",
      "options": {
        "baseURL": "{env:XIAOMI_TKN_PLAN_URL}/v1",
        "apiKey": "{env:XIAOMI_TKN_PLAN_API_KEY}"
      },
      "models": {
        "mimo-v2.5": {
          "name": "MiMo V2.5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        }
      }
    },

    // Built-in providers below (minimax, opencode-go, openai, openrouter) are
    // already fully defined by opencode via models.dev — these blocks are
    // partial overrides layered on top (per the "model overrides" note in
    // the provider schema), not full custom provider definitions, so no
    // npm/name/options here. Only `limit.context` is overridden (to 200000,
    // matching the global compaction cap above); `output` is preserved at
    // each model's real native value from models.dev so max-output behavior
    // is unaffected. 2026-08-03: added to close the gap where these four
    // providers had no context cap at all and never triggered early
    // compaction. Model list mirrors ~/.pi/agent/settings.json's
    // `providers.*.modelOverrides` (pi's equivalent fleet cap) — keep the
    // two in sync when the actively-dispatched fleet changes.
    "minimax": {
      "models": {
        "MiniMax-M2.7": { "limit": { "context": 200000, "output": 131072 } },
        "MiniMax-M2.7-highspeed": { "limit": { "context": 200000, "output": 131072 } },
        "MiniMax-M3": { "limit": { "context": 200000, "output": 128000 } }
      }
    },
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": { "limit": { "context": 200000, "output": 384000 } },
        "hy3": { "limit": { "context": 200000, "output": 64000 } },
        "kimi-k3": { "limit": { "context": 200000, "output": 131072 } },
        "mimo-v2.5-pro": { "limit": { "context": 200000, "output": 128000 } },
        "minimax-m2.7": { "limit": { "context": 200000, "output": 131072 } },
        "minimax-m3": { "limit": { "context": 200000, "output": 131072 } }
      }
    },

    "ollama": {
      // Ollama Cloud — OpenAI-compatible endpoint, API key added 2026-08-07.
      // `kimi-k3` is on the roster but requires paid "extra usage" balance
      // (plan-included quota is empty for it — confirmed via curl, returns
      // "extra usage only... balance is empty"); do not dispatch to it
      // without the user's explicit go-ahead to spend beyond the plan.
      // The models below are confirmed plan-included (verified live via a
      // real PONG round-trip, not just listed in `/api/tags`).
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_CLOUD_API_KEY}"
      },
      "models": {
        "kimi-k2.7-code": {
          // Highest LiveBench Reasoning (82.8) among plan-included Ollama
          // Cloud models per 2026-08-04 report — edges deepseek-v4-pro
          // (82.7) by 0.1, within the skill's "near-tied" band, but chosen
          // over it since it's also the closest in-plan match to the
          // requested Kimi family (kimi-k3 itself needs paid extra usage).
          "name": "Kimi K2.7 Code (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "glm-5.2": {
          "name": "GLM 5.2 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "minimax-m3": {
          "name": "MiniMax M3 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 128000 }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "kimi-k3": {
          // Confirmed reachable but NOT plan-included — dispatching here
          // spends real extra-usage balance. Only use on explicit ask.
          "name": "Kimi K3 (Ollama Cloud, extra-usage billed)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "deepseek-v4-flash:0731": {
          // Plan-included, confirmed live via a real PONG (2026-08-07).
          // Standing default for ollama/* advisor/most-capable dispatch
          // per explicit user directive 2026-08-07.
          //
          // Ollama's /api/show lists this model's reasoning capability as
          // a boolean ("thinking"), not graded effort levels — confirmed
          // live: `think:true` vs `think:false` on the native /api/chat
          // endpoint is the real on/off switch (0 chars of reasoning vs.
          // 375 on the same prompt); `reasoning_effort: low/medium/high/max`
          // on the OpenAI-compatible /v1/chat/completions endpoint didn't
          // show a reliable monotonic effect in a live comparison (likely
          // not honored by this endpoint at all, just accepted and
          // ignored). Thinking is already ON by default on this endpoint
          // (confirmed: a bare request with no variant returns populated
          // `reasoning` content) — the "max" variant below is belt-and-
          // suspenders (explicitly requests the highest effort keyword the
          // endpoint accepts without erroring) rather than a proven deeper
          // reasoning mode; don't assume `--variant max` is doing more than
          // the default until re-verified with a sharper live test.
          "name": "DeepSeek V4 Flash 0731 (Ollama Cloud)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 },
          // Max effort is the standing default for this model (user directive
          // 2026-08-09): a bare dispatch sends reasoningEffort max, not just
          // the explicit :max variant. Note the caveat in the comment above —
          // Ollama Cloud's OpenAI-compatible endpoint likely accepts and
          // ignores this keyword; think:true is the real on/off switch. Keeping
          // it as the default is safe/harmless and matches the standing
          // `--variant max` directive.
          "reasoningEffort": "max",
          "variants": {
            "max": { "reasoningEffort": "max" }
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-luna": { "limit": { "context": 200000, "output": 128000 } },
        "gpt-5.6-terra": { "limit": { "context": 200000, "output": 128000 } }
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-flash": { "limit": { "context": 200000, "output": 393216 } },
        "deepseek/deepseek-v4-flash-0731": { "limit": { "context": 200000, "output": 384000 } },
        "tencent/hy3": { "limit": { "context": 200000, "output": 128000 } },
        "tencent/hy3-preview": { "limit": { "context": 200000, "output": 262144 } }
      }
    }
  },

  "mcp": {
    "kagi": {
      "type": "local",
      "command": ["uvx", "kagimcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless", "--isolated"],
      "enabled": true
    },
    "taskferry": {
      "type": "local",
      "command": ["taskferry"],
      "enabled": false
    }
  }
}

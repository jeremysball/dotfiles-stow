[Unit]
Description=Bifrost LLM gateway (multi-provider OpenAI-compatible proxy)
After=network-online.target

[Service]
Type=simple
ExecStart=/home/jeremy/.local/share/npm-global/bin/bifrost -app-dir /home/jeremy/.local/state/bifrost -host localhost -port 3447 -log-level info
Restart=on-failure
RestartSec=3
EnvironmentFile=/home/jeremy/.config/bifrost/env
Environment=BIFROST_TRANSPORT_VERSION=v1.6.10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

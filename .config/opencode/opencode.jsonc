    "xiaomi-token-plan": {
      // Xiaomi MiMo "Token Plan" coding subscription — native Anthropic-format
      // API. The endpoint ends in `/anthropic` (no `/v1`); `/v1` is appended
      // here in baseURL because @ai-sdk/anthropic only adds `/messages` to
      // whatever baseURL it's given, not `/v1/messages`. The host is not a
      // secret, so it is inline here rather than read from an env var,
      // matching the alibaba-token-plan and nanogpt blocks.
      //   base: https://token-plan-sgp.xiaomimimo.com/anthropic/v1
      //   auth: {env:XIAOMI_TOKEN_PLAN_SGP_API_KEY}
      // Verified live 2026-07-22 via curl: both mimo-v2.5 and mimo-v2.5-pro
      // respond with real `thinking` content blocks. Context/output limits
      // per OpenRouter's listing for the same models (1.05M ctx / 131072 out
      // for both — MiMo-V2.5 is 310B-A15B MoE, MiMo-V2.5-Pro is 1.02T-A42B).
      //
      // NOTE: id deliberately NOT "xiaomi" — opencode already ships a
      // built-in `xiaomi` provider (from models.dev; that's where the
      // unrequested `mimo-v2.5-pro-ultraspeed` model came from when this was
      // first tried under the "xiaomi" id). Reusing that id let the built-in
      // definition's baseURL win the merge over ours and every call 404'd,
      // even though the same request worked fine via raw curl. A distinct id
      // avoids the collision entirely.
      "npm": "@ai-sdk/anthropic",
      "name": "Xiaomi MiMo (Token Plan)",
      "options": {
        "baseURL": "https://token-plan-sgp.xiaomimimo.com/anthropic/v1",
        "apiKey": "{env:XIAOMI_TOKEN_PLAN_SGP_API_KEY}"
      },
      "models": {
        "mimo-v2.5": {
          "name": "MiMo V2.5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 131072 }
        }
      }
    },

    // Built-in providers below (openai, openrouter) are already fully
    // defined by opencode via models.dev — these blocks are partial
    // overrides layered on top (per the "model overrides" note in the
    // provider schema), not full custom provider definitions, so no
    // npm/name/options here. Only `limit.context` is overridden (to 200000,
    // matching the global compaction cap above); `output` is preserved at
    // each model's real native value from models.dev so max-output behavior
    // is unaffected. 2026-08-03: added to close the gap where these
    // providers had no context cap at all and never triggered early
    // compaction. Model list mirrors ~/.pi/agent/settings.json's
    // `providers.*.modelOverrides` (pi's equivalent fleet cap) — keep the
    // two in sync when the actively-dispatched fleet changes.
    // 2026-08-30: minimax and opencode-go blocks commented out below (both
    // declared dead); their shapes survive for a future re-enable.
    // "minimax": {
    //   "models": {
    //     "MiniMax-M2.7": { "limit": { "context": 200000, "output": 131072 } },
    //     "MiniMax-M2.7-highspeed": { "limit": { "context": 200000, "output": 131072 } },
    //     "MiniMax-M3": { "limit": { "context": 200000, "output": 128000 } }
    //   }
    // },
    // "opencode-go": {
    //   // Parity with pi --list-models opencode-go (2026-08-22): pi lists 16
    //   // including banned deepseek-v4-pro; this file keeps the 15 non-banned
    //   // (pro excluded per standing order). Keep in sync with pi's catalog.
    //   "models": {
    //     "deepseek-v4-flash": { "limit": { "context": 200000, "output": 384000 } },
    //     "glm-5.1": { "limit": { "context": 200000, "output": 32768 } },
    //     "glm-5.2": { "limit": { "context": 200000, "output": 131072 } },
    //     "grok-4.5": { "limit": { "context": 200000, "output": 500000 } },
    //     "hy3": { "limit": { "context": 200000, "output": 64000 } },
    //     "kimi-k2.6": { "limit": { "context": 200000, "output": 65536 } },
    //     "kimi-k2.7-code": { "limit": { "context": 200000, "output": 262144 } },
    //     "kimi-k3": { "limit": { "context": 200000, "output": 131072 } },
    //     "mimo-v2.5": { "limit": { "context": 200000, "output": 128000 } },
    //     "mimo-v2.5-pro": { "limit": { "context": 200000, "output": 128000 } },
    //     "minimax-m2.7": { "limit": { "context": 200000, "output": 131072 } },
    //     "minimax-m3": { "limit": { "context": 200000, "output": 131072 } },
    //     "qwen3.6-plus": { "limit": { "context": 200000, "output": 65536 } },
    //     "qwen3.7-max": { "limit": { "context": 200000, "output": 65536 } },
    //     "qwen3.7-plus": { "limit": { "context": 200000, "output": 65536 } }
    //   }
    // },

    "ollama": {
      // Ollama Cloud — OpenAI-compatible endpoint. Standing order
      // 2026-08-21 (and 2026-08-19): ollama is ONLY flash, pro is banned
      // account-wide ("that's for anywhere that has DeepSeek pro. it's a
      // dog and I don't want it"). deepseek-v4-pro re-added below 2026-08-30
      // as a ONE-TIME explicit override for this session only ("Use
      // deepseek-v4-pro anyway" + "configure pro") — this does NOT lift the
      // standing ban; a future session should still default to flash-only
      // and re-remove this entry absent a fresh explicit go-ahead.
      // Verified live via GET https://ollama.com/v1/models 2026-08-30:
      // catalog lists the model id as "deepseek-v4-pro:0813" (dated
      // snapshot, same shape as flash's "deepseek-v4-flash:0731"), not a
      // bare "deepseek-v4-pro" alias — that's why opencode_unknownerror
      // fired on every prior dispatch attempt using the bare id.
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_CLOUD_API_KEY}"
      },
      "models": {

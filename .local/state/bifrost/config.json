{
  "providers": {
    "meta": {
      "keys": [
        {
          "name": "meta-key",
          "value": "env.META_MODEL_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.meta.ai"
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        }
      }
    },
    "kimi": {
      "keys": [
        {
          "name": "kimi-key",
          "value": "env.KIMI_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.moonshot.ai"
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        }
      }
    },
    "zai": {
      "keys": [
        {
          "name": "zai-key",
          "value": "env.ZAI_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.z.ai"
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        },
        "request_path_overrides": {
          "chat_completion": "/api/paas/v4/chat/completions",
          "chat_completion_stream": "/api/paas/v4/chat/completions"
        }
      }
    },
    "cheapestinference": {
      "keys": [
        {
          "name": "cheapestinference-key",
          "value": "env.CHEAPESTINFERENCE_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.cheapestinference.com"
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        }
      }
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-key",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ]
    }
  }
}

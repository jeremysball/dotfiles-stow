{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "quietBlue": "#274960",
    "quietTeal": "#1E4D46",
    "quietAmber": "#55431E",
    "quietRed": "#753029",
    "quietGreen": "#224E31",
    "lightBg": "#F5F3EE",
    "lightBgPanel": "#EBE8E0",
    "lightBgElement": "#E1DDD3",
    "lightText": "#1F1D1A",
    "lightBorder": "#7A6850",
    "lightBorderSubtle": "#8A7A66",
    "sepiaBg": "#2B2420",
    "sepiaBgPanel": "#352D27",
    "sepiaBgElement": "#3F362F",
    "sepiaText": "#EDE3D3",
    "sepiaBorder": "#E3C2A2",
    "sepiaBorderSubtle": "#D4B594",
    "sepiaBlue": "#9CCFEF",
    "sepiaTeal": "#87D7C3",
    "sepiaAmber": "#F2C06B",
    "sepiaRed": "#FFBAB2",
    "sepiaGreen": "#8FD8A1"
  },
  "theme": {
    "primary": { "dark": "sepiaTeal", "light": "quietTeal" },
    "secondary": { "dark": "sepiaBlue", "light": "quietBlue" },
    "accent": { "dark": "sepiaAmber", "light": "quietAmber" },
    "error": { "dark": "sepiaRed", "light": "quietRed" },
    "warning": { "dark": "sepiaAmber", "light": "quietAmber" },
    "success": { "dark": "sepiaGreen", "light": "quietGreen" },
    "info": { "dark": "sepiaTeal", "light": "quietTeal" },
    "text": { "dark": "sepiaText", "light": "lightText" },
    "background": { "dark": "sepiaBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "sepiaBgPanel", "light": "lightBgPanel" },
    "backgroundElement": { "dark": "sepiaBgElement", "light": "lightBgElement" },
    "border": { "dark": "sepiaBorder", "light": "lightBorder" },
    "borderActive": { "dark": "sepiaAmber", "light": "quietAmber" },
    "borderSubtle": { "dark": "sepiaBorderSubtle", "light": "lightBorderSubtle" },
    "diffAdded": { "dark": "sepiaGreen", "light": "quietGreen" },
    "diffRemoved": { "dark": "sepiaRed", "light": "quietRed" },
    "diffContext": { "dark": "sepiaText", "light": "lightText" },
    "markdownText": { "dark": "sepiaText", "light": "lightText" },
    "markdownHeading": { "dark": "sepiaAmber", "light": "quietAmber" },
    "markdownLink": { "dark": "sepiaTeal", "light": "quietTeal" },
    "syntaxKeyword": { "dark": "sepiaBlue", "light": "quietBlue" },
    "syntaxString": { "dark": "sepiaGreen", "light": "quietGreen" },
    "syntaxComment": { "dark": "sepiaText", "light": "lightText" }
  }
}

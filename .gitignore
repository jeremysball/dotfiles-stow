fish_variables*

# Fisher-managed plugin output. Only the fish_plugins manifest is tracked;
# conf.d/fisher-bootstrap.fish reinstalls these from it on a fresh machine.
#
# With `stow --no-folding` these land in the real ~/.config/fish/ and never
# reach the repo. These rules are the safety net for a folded stow,
# where ~/.config/fish/functions is a symlink pointing back in here.
fish/.config/fish/functions/_tide_*.fish
fish/.config/fish/functions/tide/
fish/.config/fish/functions/tide.fish
fish/.config/fish/functions/fisher.fish
fish/.config/fish/functions/fish_prompt.fish
fish/.config/fish/functions/fish_right_prompt.fish
fish/.config/fish/completions/tide.fish
fish/.config/fish/completions/fisher.fish
fish/.config/fish/conf.d/_tide_init.fish

# Local worktrees
.worktrees/
